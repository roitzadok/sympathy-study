# Azure PostgreSQL Database Connection
# For local development, set these values to connect to your Azure PostgreSQL server.
# Use Azure AD token auth when running in Azure App Service with a system-assigned managed identity.
# For password fallback locally, provide AZURE_DATABASE_PASSWORD.
AZURE_DATABASE_URL="postgresql://ht-postgres-server.postgres.database.azure.com:5432/headtiltdb?sslmode=require"
AZURE_DATABASE_USER="dbadmin"
AZURE_DATABASE_PASSWORD="<your-dbadmin-password>"
APP_NAME="ht-webapp-rl5fjqpxljppw"
# Note: In production on Azure App Service, set AZURE_DATABASE_URL, AZURE_DATABASE_USER, and optionally AZURE_DATABASE_PASSWORD in the App Service Configuration > Application Settings.
# If using Azure AD authentication from App Service, leave AZURE_DATABASE_PASSWORD blank and provide a valid AAD user in AZURE_DATABASE_USER.

